      replacement_content: "import React from \'react\';\nimport { ShieldCheck, Clock, MessageSquare, Target, Wrench } from \'lucide-react\';\n\nexport const AboutSection: React.FC = () => {\n  return (\n    <section id=\"about\" className=\"py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-[#f2f4f6] border-b border-[#c6c6cd]/50\">\n      <div className=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n        \n        {/* Left Column: Visual Card \"25 Years Operational Discipline\" */}\n        <div className=\"lg:col-span-5 order-2 lg:order-1 relative\">\n          <div className=\"bg-white border border-[#c6c6cd] rounded-xl overflow-hidden shadow-sm p-8 sm:p-12 flex flex-col justify-center items-center text-center relative group hover:border-[#0ea5e9] transition-all\">\n            \n            <div className=\"w-24 h-24 sm:w-28 sm:h-28 bg-[#f1f5f9] rounded-2xl flex items-center justify-center text-[#c6c6cd] group-hover:text-[#0ea5e9] transition-colors mb-6 border border-[#c6c6cd]/50\">\n              <span className=\"material-symbols-outlined text-[64px]\">engineering</span>\n            </div>\n\n            <h4 className=\"font-geist font-bold text-3xl sm:text-4xl text-[#191c1e] mb-2\">\n              25 Years\n            </h4>\n            <p className=\"text-base text-[#45464d] font-medium\">\n              Operational Discipline\n            </p>\n            <p className=\"text-xs text-[#76777d] mt-2 font-mono\">\n              Logistics Leadership &rarr; Software Engineering\n            </p>\n          </div>\n\n          {/* Floating Badge */}\n          <div className=\"absolute -bottom-5 -right-2 sm:-right-4 bg-[#f1f5f9] border border-[#c6c6cd] px-4 py-3 rounded-lg shadow-md flex items-center gap-3\">\n            <ShieldCheck className=\"w-5 h-5 text-[#006591]\" />\n            <span className=\"font-geist font-semibold text-xs sm:text-sm text-[#191c1e]\">\n              Reliable Execution\n            </span>\n          </div>\n        </div>\n\n        {/* Right Column: Copy & Principles */}\n        <div className=\"lg:col-span-7 order-1 lg:order-2 flex flex-col gap-6\">\n          \n          <div className=\"inline-flex items-center gap-2 bg-[#ffffff] border border-[#c6c6cd] text-[#006591] px-3 py-1 rounded-full text-xs font-mono font-semibold w-fit\">\n            <Wrench className=\"w-3.5 h-3.5 text-[#0ea5e9]\" />\n            <span>Operational Background</span>\n          </div>\n\n          <h2 className=\"font-geist font-bold text-2xl sm:text-4xl text-[#191c1e] leading-snug\">\n            Built on Operational Discipline.\n          </h2>\n\n          <p className=\"text-base sm:text-lg text-[#45464d] leading-relaxed\">\n            Before tech, I spent 25 years in logistics. I know what it means to deliver on time, handle complex systems under pressure, and maintain strict operational standards.\n          </p>\n\n          <p className=\"text-sm sm:text-base text-[#45464d] leading-relaxed\">\n            I bring that same rigorous work ethic and reliability to web development. When you work with me, you\'re getting more than just code; you\'re getting a dedicated partner who understands business operations and builds reliable, hard-working digital infrastructure to support it.\n          </p>\n\n          {/* Core Principles */}\n          <ul className=\"space-y-4 pt-2\">\n            <li className=\"flex items-start gap-3\">\n              <span className=\"w-1.5 h-6 bg-[#0ea5e9] rounded-sm shrink-0 mt-0.5\"></span>\n              <div>\n                <p className=\"font-geist font-semibold text-sm sm:text-base text-[#191c1e]\">Zero missed deadlines.</p>\n                <p className=\"text-xs text-[#45464d]\">Structured project milestones with clear delivery dates guaranteed upfront.</p>\n              </div>\n            </li>\n\n            <li className=\"flex items-start gap-3\">\n              <span className=\"w-1.5 h-6 bg-[#0ea5e9] rounded-sm shrink-0 mt-0.5\"></span>\n              <div>\n                <p className=\"font-geist font-semibold text-sm sm:text-base text-[#191c1e]\">Transparent communication.</p>\n                <p className=\"text-xs text-[#45464d]\">Direct WhatsApp access and weekly progress builds so you\'re never in the dark.</p>\n              </div>\n            </li>\n\n            <li className=\"flex items-start gap-3\">\n              <span className=\"w-1.5 h-6 bg-[#0ea5e9] rounded-sm shrink-0 mt-0.5\"></span>\n              <div>\n                <p className=\"font-geist font-semibold text-sm sm:text-base text-[#191c1e]\">Focus on tangible ROI.</p>\n                <p className=\"text-xs text-[#45464d]\">Every design decision is rooted in converting local traffic into paying clients.</p>\n              </div>\n            </li>\n          </ul>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
