    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Send, CheckCircle2, MessageSquare, Clock, Calculator, ShieldCheck, X, Sparkles } from \'lucide-react\';\nimport { QuoteResult } from \'../types\';\n\ninterface QuoteFormProps {\n  onOpenWhatsApp: () => void;\n}\n\nexport const QuoteForm: React.FC<QuoteFormProps> = ({ onOpenWhatsApp }) => {\n  const [formData, setFormData] = useState({\n    name: \'\',\n    company: \'\',\n    email: \'\',\n    phone: \'\',\n    projectType: \'full-site\',\n    budget: \'1800-3200\',\n    details: \'\',\n  });\n\n  const [loading, setLoading] = useState(false);\n  const [result, setResult] = useState<QuoteResult | null>(null);\n\n  // Live estimated investment based on choices\n  const getEstimatedPrice = () => {\n    if (formData.projectType === \'starter\') return \'\302\243850 - \302\2431,500\';\n    if (formData.projectType === \'full-site\') return \'\302\2431,800 - \302\2433,200\';\n    if (formData.projectType === \'app\') return \'\302\2433,500+\';\n    if (formData.projectType === \'audit\') return \'\302\243350 - \302\243600\';\n    return \'\302\2431,800 - \302\2433,200\';\n  };\n\n  const getEstimatedTime = () => {\n    if (formData.projectType === \'starter\') return \'7 - 10 Days\';\n    if (formData.projectType === \'full-site\') return \'2 - 3 Weeks\';\n    if (formData.projectType === \'app\') return \'3 - 4 Weeks\';\n    if (formData.projectType === \'audit\') return \'3 - 5 Days\';\n    return \'2 - 3 Weeks\';\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setLoading(true);\n\n    try {\n      const res = await fetch(\'/api/quote\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify(formData),\n      });\n\n      if (res.ok) {\n        const json = await res.json();\n        setResult(json);\n      } else {\n        // Fallback result\n        setResult({\n          refNumber: \'DW-\' + Math.floor(100000 + Math.random() * 900000),\n          clientName: formData.name || \'Valued Client\',\n          estimatedCost: getEstimatedPrice(),\n          turnaround: getEstimatedTime(),\n          message: `Thank you, ${formData.name || \'friend\'}! Your request has been logged. Dean will review your specifications and get in touch at ${formData.email} within 24 hours.`,\n        });\n      }\n    } catch (err) {\n      console.error(\'Quote submission error:\', err);\n      setResult({\n        refNumber: \'DW-\' + Math.floor(100000 + Math.random() * 900000),\n        clientName: formData.name || \'Valued Client\',\n        estimatedCost: getEstimatedPrice(),\n        turnaround: getEstimatedTime(),\n        message: `Thank you, ${formData.name || \'friend\'}! Your request has been logged. Dean will review your specifications and get in touch at ${formData.email} within 24 hours.`,\n      });\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <section id=\"contact\" className=\"py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-[#f7f9fb] border-b border-[#c6c6cd]/50\">\n      <div className=\"max-w-4xl mx-auto\">\n        \n        {/* Header */}\n        <div className=\"text-center mb-10 flex flex-col items-center\">\n          <span className=\"text-xs font-mono uppercase tracking-widest text-[#006591] font-semibold mb-2 bg-sky-50 px-3 py-1 rounded-full border border-sky-100\">\n            Direct Studio Inquiry\n          </span>\n          <h2 className=\"font-geist font-bold text-2xl sm:text-4xl text-[#191c1e] mb-3\">\n            Request a Quote\n          </h2>\n          <p className=\"text-[#45464d] text-sm sm:text-base max-w-lg\">\n            Tell me about your project and business goals. I\'ll review your scope and get back to you within 24 hours.\n          </p>\n        </div>\n\n        {/* Form Container */}\n        <div className=\"bg-[#ffffff] border border-[#c6c6cd] p-6 sm:p-10 rounded-xl shadow-xs relative\">\n          \n          <form onSubmit={handleSubmit} className=\"space-y-6\">\n            \n            {/* Row 1: Name & Company */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n              <div>\n                <label className=\"block font-geist font-semibold text-xs text-[#191c1e] uppercase tracking-wider mb-1.5\" htmlFor=\"name\">\n                  Name <span className=\"text-rose-500\">*</span>\n                </label>\n                <input\n                  id=\"name\"\n                  type=\"text\"\n                  required\n                  placeholder=\"John Doe\"\n                  value={formData.name}\n                  onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n                  className=\"w-full bg-[#ffffff] border border-[#c6c6cd] rounded-lg px-3.5 py-2.5 text-sm text-[#191c1e] focus:border-[#191c1e] focus:ring-1 focus:ring-[#191c1e] focus:outline-none transition-colors\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-geist font-semibold text-xs text-[#191c1e] uppercase tracking-wider mb-1.5\" htmlFor=\"company\">\n                  Company (Optional)\n                </label>\n                <input\n                  id=\"company\"\n                  type=\"text\"\n                  placeholder=\"Acme Corp\"\n                  value={formData.company}\n                  onChange={(e) => setFormData({ ...formData, company: e.target.value })}\n                  className=\"w-full bg-[#ffffff] border border-[#c6c6cd] rounded-lg px-3.5 py-2.5 text-sm text-[#191c1e] focus:border-[#191c1e] focus:ring-1 focus:ring-[#191c1e] focus:outline-none transition-colors\"\n                />\n              </div>\n            </div>\n\n            {/* Row 2: Email & Phone */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n              <div>\n                <label className=\"block font-geist font-semibold text-xs text-[#191c1e] uppercase tracking-wider mb-1.5\" htmlFor=\"email\">\n                  Email <span className=\"text-rose-500\">*</span>\n                </label>\n                <input\n                  id=\"email\"\n                  type=\"email\"\n                  required\n                  placeholder=\"john@example.com\"\n                  value={formData.email}\n                  onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                  className=\"w-full bg-[#ffffff] border border-[#c6c6cd] rounded-lg px-3.5 py-2.5 text-sm text-[#191c1e] focus:border-[#191c1e] focus:ring-1 focus:ring-[#191c1e] focus:outline-none transition-colors\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-geist font-semibold text-xs text-[#191c1e] uppercase tracking-wider mb-1.5\" htmlFor=\"phone\">\n                  Phone (Optional)\n                </label>\n                <input\n                  id=\"phone\"\n                  type=\"tel\"\n                  placeholder=\"07700 900123\"\n                  value={formData.phone}\n                  onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                  className=\"w-full bg-[#ffffff] border border-[#c6c6cd] rounded-lg px-3.5 py-2.5 text-sm text-[#191c1e] focus:border-[#191c1e] focus:ring-1 focus:ring-[#191c1e] focus:outline-none transition-colors\"\n                />\n              </div>\n            </div>\n\n            {/* Row 3: Project Type & Estimated Calculation Panel */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5\">\n              <div>\n                <label className=\"block font-geist font-semibold text-xs text-[#191c1e] uppercase tracking-wider mb-1.5\" htmlFor=\"projectType\">\n                  Project Type\n                </label>\n                <select\n                  id=\"projectType\"\n                  value={formData.projectType}\n                  onChange={(e) => setFormData({ ...formData, projectType: e.target.value })}\n                  className=\"w-full bg-[#ffffff] border border-[#c6c6cd] rounded-lg px-3.5 py-2.5 text-sm text-[#191c1e] focus:border-[#191c1e] focus:outline-none transition-colors\"\n                >\n                  <option value=\"full-site\">Full Lead-Gen Website (\302\2431,800 - \302\2433,200)</option>\n                  <option value=\"starter\">Starter Landing Page (\302\243850 - \302\2431,500)</option>\n                  <option value=\"app\">Custom React Web Application (\302\2433,500+)</option>\n                  <option value=\"audit\">Technical SEO & Speed Audit (\302\243350 - \302\243600)</option>\n                </select>\n              </div>\n\n              {/* Dynamic Estimator Card */}\n              <div className=\"bg-[#f1f5f9] border border-[#c6c6cd]/80 p-3.5 rounded-lg flex items-center justify-between\">\n                <div>\n                  <div className=\"flex items-center gap-1.5 text-xs text-[#006591] font-bold font-mono\">\n                    <Calculator className=\"w-3.5 h-3.5 text-[#0ea5e9]\" />\n                    <span>Estimated Guide:</span>\n                  </div>\n                  <span className=\"text-lg font-geist font-bold text-[#191c1e]\">\n                    {getEstimatedPrice()}\n                  </span>\n                </div>\n\n                <div className=\"text-right\">\n                  <div className=\"flex items-center gap-1 text-[11px] text-slate-500 font-mono\">\n                    <Clock className=\"w-3 h-3 text-emerald-600\" />\n                    <span>Turnaround</span>\n                  </div>\n                  <span className=\"text-xs font-bold text-slate-800 font-geist\">\n                    {getEstimatedTime()}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            {/* Row 4: Project Details */}\n            <div>\n              <label className=\"block font-geist font-semibold text-xs text-[#191c1e] uppercase tracking-wider mb-1.5\" htmlFor=\"details\">\n                Project Details\n              </label>\n              <textarea\n                id=\"details\"\n                rows={4}\n                placeholder=\"What are you looking to build? (e.g., Local plumbing business website with booking form and WhatsApp integration)\"\n                value={formData.details}\n                onChange={(e) => setFormData({ ...formData, details: e.target.value })}\n                className=\"w-full bg-[#ffffff] border border-[#c6c6cd] rounded-lg px-3.5 py-2.5 text-sm text-[#191c1e] focus:border-[#191c1e] focus:ring-1 focus:ring-[#191c1e] focus:outline-none transition-colors\"\n              ></textarea>\n            </div>\n\n            {/* Submit Button */}\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"w-full bg-[#0ea5e9] hover:bg-[#0284c7] text-white py-3.5 rounded-lg font-geist font-semibold text-sm sm:text-base transition-opacity shadow-sm flex items-center justify-center gap-2\"\n            >\n              {loading ? (\n                <span>Generating Quote Request...</span>\n              ) : (\n                <>\n                  <span>Submit Request</span>\n                  <Send className=\"w-4 h-4\" />\n                </>\n              )}\n            </button>\n\n            <div className=\"text-center pt-1\">\n              <span className=\"text-xs text-[#76777d] flex items-center justify-center gap-1.5\">\n                <ShieldCheck className=\"w-4 h-4 text-emerald-600\" />\n                No obligations. Dean will respond directly within 24 hours.\n              </span>\n            </div>\n\n          </form>\n\n        </div>\n\n        {/* Confirmation Modal */}\n        {result && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-fadeIn\">\n            <div className=\"bg-white border border-[#c6c6cd] rounded-xl max-w-md w-full p-6 shadow-2xl relative space-y-5\">\n              <button\n                onClick={() => setResult(null)}\n                className=\"absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-1 rounded-full hover:bg-slate-100\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-12 h-12 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center shrink-0\">\n                  <CheckCircle2 className=\"w-6 h-6\" />\n                </div>\n                <div>\n                  <span className=\"text-[10px] font-mono bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold\">\n                    REQUEST RECEIVED #{result.refNumber}\n                  </span>\n                  <h3 className=\"font-geist font-bold text-xl text-slate-900\">Quote Logged!</h3>\n                </div>\n              </div>\n\n              <div className=\"bg-slate-50 p-4 rounded-lg border border-slate-200 text-xs space-y-2 text-slate-700\">\n                <p className=\"font-medium\">{result.message}</p>\n                <div className=\"pt-2 border-t border-slate-200 grid grid-cols-2 gap-2 text-[11px]\">\n                  <div>\n                    <span className=\"text-slate-400 font-mono uppercase\">Guide Investment:</span>\n                    <p className=\"font-bold text-slate-900\">{result.estimatedCost}</p>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-400 font-mono uppercase\">Turnaround:</span>\n                    <p className=\"font-bold text-slate-900\">{result.turnaround}</p>\n                  </div>\n                </div>\n              </div>\n\n              <div className=\"space-y-2 pt-2\">\n                <button\n                  onClick={() => {\n                    setResult(null);\n                    onOpenWhatsApp();\n                  }}\n                  className=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white py-2.5 rounded-lg text-xs font-semibold flex justify-center items-center gap-2\"\n                >\n                  <MessageSquare className=\"w-4 h-4\" />\n                  Speed Up: Send via WhatsApp Too\n                </button>\n\n                <button\n                  onClick={() => setResult(null)}\n                  className=\"w-full border border-slate-300 text-slate-700 hover:bg-slate-50 py-2.5 rounded-lg text-xs font-semibold\"\n                >\n                  Close Confirmation\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n\n      </div>\n    </section>\n  );\n};\n"
    }
