    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Rocket, ArrowRight, MessageCircle, ShieldCheck, Zap, Code2, Gauge, CheckCircle2 } from \'lucide-react\';\n\ninterface HeroProps {\n  onOpenQuote: () => void;\n  onOpenWhatsApp: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({ onOpenQuote, onOpenWhatsApp }) => {\n  const [activeTab, setActiveTab] = useState<\'preview\' | \'code\' | \'audit\'>(\'preview\');\n\n  return (\n    <section className=\"relative pt-24 sm:pt-32 pb-16 sm:pb-24 px-4 sm:px-6 lg:px-8 grid-bg overflow-hidden border-b border-[#c6c6cd]/40\">\n      <div className=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n        \n        {/* Left Column: Hero Copy & Actions */}\n        <div className=\"lg:col-span-7 flex flex-col gap-6 items-start text-left z-10\">\n          {/* Engineered Badge */}\n          <div className=\"bg-[#f1f5f9] text-[#191c1e] px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide inline-flex items-center gap-2 border border-[#c6c6cd] shadow-2xs\">\n            <Rocket className=\"w-4 h-4 text-[#0ea5e9]\" />\n            <span>Engineered for Performance</span>\n            <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-500\"></span>\n          </div>\n\n          {/* Main Display Headline */}\n          <h1 className=\"font-geist font-bold text-3xl sm:text-5xl lg:text-6xl text-[#191c1e] leading-[1.15] tracking-tight\">\n            High-Performance Websites for{\' \'}\n            <span className=\"text-[#006591] bg-gradient-to-r from-[#006591] to-[#0ea5e9] bg-clip-text text-transparent\">\n              Local Business Growth.\n            </span>\n          </h1>\n\n          {/* Subtitle */}\n          <p className=\"text-lg sm:text-xl text-[#45464d] leading-relaxed max-w-2xl font-normal\">\n            Bespoke, lightning-fast builds designed to convert Cheshire &amp; Stoke-on-Trent traffic into paying customers. No bloated templates, just engineered results.\n          </p>\n\n          {/* Action Buttons */}\n          <div className=\"flex flex-col sm:flex-row gap-3.5 pt-2 w-full sm:w-auto\">\n            <button\n              onClick={onOpenQuote}\n              className=\"bg-[#0ea5e9] hover:bg-[#0284c7] text-white px-6 py-3.5 rounded-lg font-semibold text-sm sm:text-base text-center transition-all shadow-sm hover:shadow-md flex justify-center items-center gap-2 group\"\n            >\n              Get a Quote\n              <ArrowRight className=\"w-4 h-4 group-hover:translate-x-1 transition-transform\" />\n            </button>\n\n            <button\n              onClick={onOpenWhatsApp}\n              className=\"border border-[#191c1e] text-[#191c1e] bg-white hover:bg-[#eceef0] px-6 py-3.5 rounded-lg font-semibold text-sm sm:text-base text-center transition-all flex justify-center items-center gap-2\"\n            >\n              <MessageCircle className=\"w-4 h-4 text-emerald-600\" />\n              Message on WhatsApp\n            </button>\n          </div>\n\n          {/* Micro Proof Bar */}\n          <div className=\"grid grid-cols-3 gap-4 pt-4 border-t border-[#c6c6cd]/50 w-full max-w-xl text-xs sm:text-sm text-[#45464d]\">\n            <div className=\"flex items-center gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n              <span>100/100 Speed Score</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n              <span>Zero Plugin Bloat</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n              <span>2-3 Wk Turnaround</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Interactive Browser Code & Speed Mockup */}\n        <div className=\"lg:col-span-5 relative w-full\">\n          <div className=\"bg-white rounded-xl border border-[#c6c6cd] shadow-xl overflow-hidden transition-all transform hover:-translate-y-1 duration-300\">\n            \n            {/* Browser Header Bar */}\n            <div className=\"bg-[#eceef0] border-b border-[#c6c6cd] px-4 py-3 flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-3 h-3 rounded-full bg-rose-400\"></div>\n                <div className=\"w-3 h-3 rounded-full bg-amber-400\"></div>\n                <div className=\"w-3 h-3 rounded-full bg-emerald-400\"></div>\n                <span className=\"text-xs text-[#76777d] font-mono ml-2 hidden sm:inline-block\">https://cheshire-client.co.uk</span>\n              </div>\n\n              {/* View Tabs */}\n              <div className=\"flex items-center bg-[#e0e3e5] p-0.5 rounded-md text-xs font-medium\">\n                <button\n                  onClick={() => setActiveTab(\'preview\')}\n                  className={`px-2.5 py-1 rounded transition-colors flex items-center gap-1 ${\n                    activeTab === \'preview\' ? \'bg-white text-[#006591] font-semibold shadow-2xs\' : \'text-[#76777d] hover:text-[#191c1e]\'\n                  }`}\n                >\n                  <Zap className=\"w-3 h-3\" />\n                  Live\n                </button>\n                <button\n                  onClick={() => setActiveTab(\'code\')}\n                  className={`px-2.5 py-1 rounded transition-colors flex items-center gap-1 ${\n                    activeTab === \'code\' ? \'bg-white text-[#006591] font-semibold shadow-2xs\' : \'text-[#76777d] hover:text-[#191c1e]\'\n                  }`}\n                >\n                  <Code2 className=\"w-3 h-3\" />\n                  Code\n                </button>\n                <button\n                  onClick={() => setActiveTab(\'audit\')}\n                  className={`px-2.5 py-1 rounded transition-colors flex items-center gap-1 ${\n                    activeTab === \'audit\' ? \'bg-white text-[#006591] font-semibold shadow-2xs\' : \'text-[#76777d] hover:text-[#191c1e]\'\n                  }`}\n                >\n                  <Gauge className=\"w-3 h-3\" />\n                  Audit\n                </button>\n              </div>\n            </div>\n\n            {/* Window Content */}\n            <div className=\"p-5 min-h-[320px] bg-slate-50 dot-bg\">\n              {activeTab === \'preview\' && (\n                <div className=\"space-y-4 animate-fadeIn\">\n                  <div className=\"bg-white p-4 rounded-lg border border-[#e0e3e5] shadow-xs space-y-3\">\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"text-xs font-mono text-[#006591] bg-sky-50 px-2 py-0.5 rounded font-semibold\">CUSTOM REACT ENGINE</span>\n                      <span className=\"text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded flex items-center gap-1\">\n                        <ShieldCheck className=\"w-3 h-3\" /> 0.38s LCP\n                      </span>\n                    </div>\n\n                    <div className=\"w-full bg-slate-100 h-3 rounded-full overflow-hidden\">\n                      <div className=\"bg-[#0ea5e9] h-full w-[94%] rounded-full animate-pulse\"></div>\n                    </div>\n\n                    <div className=\"p-3 bg-[#f8fafc] rounded border border-slate-200 text-xs text-slate-700 space-y-2\">\n                      <p className=\"font-medium text-slate-900\">Cheshire Plumbing &amp; Heating Solutions</p>\n                      <p className=\"text-slate-500\">Fast, local emergency bookings in Crewe &amp; Stoke-on-Trent.</p>\n                      <div className=\"flex gap-2 pt-1\">\n                        <span className=\"bg-[#0ea5e9] text-white px-2.5 py-1 rounded text-[11px] font-semibold\">Book Online Now</span>\n                        <span className=\"border border-slate-300 text-slate-700 px-2.5 py-1 rounded text-[11px]\">01270 500 112</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-3\">\n                    <div className=\"bg-white p-3 rounded-lg border border-slate-200 text-center\">\n                      <span className=\"text-2xl font-bold font-geist text-slate-900\">100/100</span>\n                      <p className=\"text-[11px] text-slate-500 font-medium\">Lighthouse Speed</p>\n                    </div>\n                    <div className=\"bg-white p-3 rounded-lg border border-slate-200 text-center\">\n                      <span className=\"text-2xl font-bold font-geist text-emerald-600\">+42%</span>\n                      <p className=\"text-[11px] text-slate-500 font-medium\">Lead Conversion</p>\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {activeTab === \'code\' && (\n                <div className=\"bg-[#1e293b] text-slate-200 p-4 rounded-lg font-mono text-xs overflow-x-auto leading-relaxed shadow-inner animate-fadeIn\">\n                  <p className=\"text-purple-400\">// Bespoke React + Vite Component</p>\n                  <p className=\"text-blue-400\">export default function <span className=\"text-yellow-300\">FastBusinessPortal</span>() &#123;</p>\n                  <p className=\"pl-4 text-emerald-300\">const <span className=\"text-slate-200\">vitals</span> = usePerformanceMeter();</p>\n                  <p className=\"pl-4 text-purple-300\">return (</p>\n                  <p className=\"pl-8 text-cyan-300\">&lt;<span className=\"text-rose-400\">Section</span> <span className=\"text-slate-300\">type=</span><span className=\"text-amber-300\">\"lead-gen\"</span>&gt;</p>\n                  <p className=\"pl-12 text-slate-200\">&lt;<span className=\"text-rose-400\">FastHeader</span> speed=&#123;vitals.lcp&#125; /&gt;</p>\n                  <p className=\"pl-12 text-slate-200\">&lt;<span className=\"text-rose-400\">InstantLeadForm</span> location=<span className=\"text-amber-300\">\"Cheshire &amp; Stoke\"</span> /&gt;</p>\n                  <p className=\"pl-8 text-cyan-300\">&lt;/<span className=\"text-rose-400\">Section</span>&gt;</p>\n                  <p className=\"pl-4 text-purple-300\">);</p>\n                  <p className=\"text-blue-400\">&#125;</p>\n                </div>\n              )}\n\n              {activeTab === \'audit\' && (\n                <div className=\"space-y-3 animate-fadeIn\">\n                  <div className=\"bg-white p-3.5 rounded-lg border border-slate-200 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold font-geist text-sm\">\n                        100\n                      </div>\n                      <div>\n                        <p className=\"font-semibold text-xs text-slate-900\">Performance</p>\n                        <p className=\"text-[11px] text-slate-500\">First Contentful Paint: 0.2s</p>\n                      </div>\n                    </div>\n                    <span className=\"text-xs bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-1 rounded font-mono font-bold\">Passed</span>\n                  </div>\n\n                  <div className=\"bg-white p-3.5 rounded-lg border border-slate-200 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-10 h-10 rounded-full bg-sky-100 text-[#006591] flex items-center justify-center font-bold font-geist text-sm\">\n                        100\n                      </div>\n                      <div>\n                        <p className=\"font-semibold text-xs text-slate-900\">SEO &amp; Schema Markup</p>\n                        <p className=\"text-[11px] text-slate-500\">Local Business Structured Data</p>\n                      </div>\n                    </div>\n                    <span className=\"text-xs bg-sky-50 text-[#006591] border border-sky-200 px-2 py-1 rounded font-mono font-bold\">Verified</span>\n                  </div>\n\n                  <div className=\"bg-white p-3.5 rounded-lg border border-slate-200 flex items-center justify-between\">\n                    <div className=\"flex items-center gap-3\">\n                      <div className=\"w-10 h-10 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center font-bold font-geist text-sm\">\n                        100\n                      </div>\n                      <div>\n                        <p className=\"font-semibold text-xs text-slate-900\">Security &amp; Best Practices</p>\n                        <p className=\"text-[11px] text-slate-500\">Zero database vulnerabilities</p>\n                      </div>\n                    </div>\n                    <span className=\"text-xs bg-purple-50 text-purple-700 border border-purple-200 px-2 py-1 rounded font-mono font-bold\">Secure</span>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Bottom Footer Note */}\n            <div className=\"bg-[#eceef0] px-4 py-2.5 border-t border-[#c6c6cd] text-[11px] text-[#45464d] flex items-center justify-between\">\n              <span className=\"font-medium\">Cheshire &amp; Stoke Local Engine</span>\n              <span className=\"text-emerald-700 font-semibold flex items-center gap-1\">\n                <span className=\"w-2 h-2 rounded-full bg-emerald-500\"></span> Live Benchmark\n              </span>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
