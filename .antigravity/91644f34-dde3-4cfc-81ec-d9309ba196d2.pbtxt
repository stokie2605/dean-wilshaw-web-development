  file_change {
    absolute_path_uri: "file:///src/components/ServicesBento.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Speedometer, TrendingUp, Search, Layers, ArrowUpRight, Check, X } from \'lucide-react\';\n\ninterface ServiceDetail {\n  id: string;\n  title: string;\n  badge: string;\n  icon: React.ReactNode;\n  bgIconName: string;\n  description: string;\n  tags: string[];\n  features: string[];\n  techStack: string;\n  roiImpact: string;\n}\n\nconst SERVICES: ServiceDetail[] = [\n  {\n    id: \'react-builds\',\n    title: \'Custom React Builds\',\n    badge: \'Lightning Speed\',\n    icon: <Speedometer className=\"w-6 h-6 text-[#191c1e]\" />,\n    bgIconName: \'code\',\n    description: \'Lightning-fast, highly interactive web applications built with modern React & Vite. Zero bloat, maximum performance.\',\n    tags: [\'PERFORMANCE\', \'VITE\', \'REACT 19\'],\n    features: [\n      \'Sub-0.5s First Contentful Paint (FCP)\',\n      \'100/100 Core Web Vitals Lighthouse score\',\n      \'No slow WordPress database or plugin queries\',\n      \'Fully responsive, mobile-first design architecture\'\n    ],\n    techStack: \'React 19, TypeScript, Vite, Tailwind CSS\',\n    roiImpact: \'Higher Google ranking and lower bounce rates (users leave slow sites within 3 seconds).\'\n  },\n  {\n    id: \'lead-gen\',\n    title: \'Lead-Gen Focused\',\n    badge: \'High Conversion\',\n    icon: <TrendingUp className=\"w-6 h-6 text-[#191c1e]\" />,\n    bgIconName: \'trending_up\',\n    description: \'Strategic UI/UX design focused on conversion rate optimization (CRO) to turn Cheshire & Stoke visitors into qualified leads.\',\n    tags: [\'ROI\', \'CRO\', \'LEAD CAPTURE\'],\n    features: [\n      \'Conversion-focussed CTA placement above the fold\',\n      \'Frictionless inquiry forms & instant estimate tools\',\n      \'Direct WhatsApp click-to-chat integration\',\n      \'Trust badges, client proof points & local coverage tags\'\n    ],\n    techStack: \'Custom Lead Engine, Automated Form Routing\',\n    roiImpact: \'Up to 3x increase in submitted quote requests compared to passive brochure templates.\'\n  },\n  {\n    id: \'technical-seo\',\n    title: \'Modern Technical SEO\',\n    badge: \'Search Domination\',\n    icon: <Search className=\"w-6 h-6 text-[#191c1e]\" />,\n    bgIconName: \'search\',\n    description: \'Semantic HTML, Schema markup, and Core Web Vitals optimization to ensure high visibility on Google for local keywords.\',\n    tags: [\'VISIBILITY\', \'SEMANTICS\', \'SCHEMA\'],\n    features: [\n      \'Full LocalBusiness JSON-LD Schema integration\',\n      \'Clean semantic HTML5 structure (H1-H6 hierarchy)\',\n      \'Automated sitemap & robots.txt search engine indexing\',\n      \'Geo-targeted metadata for Cheshire, Stoke-on-Trent, & Crewe\'\n    ],\n    techStack: \'JSON-LD Schema, OpenGraph Metadata, SSR Ready\',\n    roiImpact: \'Outrank bloated local competitor websites stuck on legacy page builders.\'\n  },\n  {\n    id: \'lead-tracking\',\n    title: \'Operational Integrations\',\n    badge: \'Automated Workflow\',\n    icon: <Layers className=\"w-6 h-6 text-[#191c1e]\" />,\n    bgIconName: \'database\',\n    description: \'Custom booking flows, WhatsApp auto-routing, and automated lead alerts sent directly to your phone or CRM.\',\n    tags: [\'WORKFLOW\', \'AUTOMATION\', \'CRM\'],\n    features: [\n      \'Instant SMS / Email / WhatsApp lead notifications\',\n      \'Custom pricing estimator & interactive quote forms\',\n      \'Google Analytics & conversion event tracking\',\n      \'Zero maintenance overhead with static cloud deployment\'\n    ],\n    techStack: \'Node.js, Express, Webhooks, WhatsApp API\',\n    roiImpact: \'Never miss a customer inquiry while out on job sites or managing operations.\'\n  }\n];\n\nexport const ServicesBento: React.FC = () => {\n  const [selectedService, setSelectedService] = useState<ServiceDetail | null>(null);\n\n  return (\n    <section id=\"services\" className=\"py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-[#ffffff] border-b border-[#c6c6cd]/50\">\n      <div className=\"max-w-7xl mx-auto\">\n        \n        {/* Section Header */}\n        <div className=\"text-center mb-12 flex flex-col items-center\">\n          <span className=\"text-xs font-mono uppercase tracking-widest text-[#006591] font-semibold mb-2 bg-sky-50 px-3 py-1 rounded-full border border-sky-100\">\n            Tailored Engineering\n          </span>\n          <h2 className=\"font-geist font-bold text-2xl sm:text-4xl text-[#191c1e] mb-3\">\n            Engineered Solutions\n          </h2>\n          <div className=\"w-16 h-1 bg-[#0ea5e9] rounded-full\"></div>\n          <p className=\"mt-4 text-[#45464d] max-w-xl text-sm sm:text-base\">\n            Every build is engineered from scratch for maximum speed, local Google dominance, and predictable lead generation.\n          </p>\n        </div>\n\n        {/* Bento Grid Layout */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n          {SERVICES.map((service) => (\n            <div\n              key={service.id}\n              onClick={() => setSelectedService(service)}\n              className=\"bg-[#f7f9fb] border border-[#c6c6cd]/80 hover:border-[#0ea5e9] rounded-xl p-6 hover:shadow-lg transition-all duration-300 group flex flex-col justify-between relative overflow-hidden cursor-pointer\"\n            >\n              {/* Background Icon Watermark */}\n              <div className=\"absolute top-2 right-2 p-2 opacity-[0.07] group-hover:opacity-15 transition-opacity pointer-events-none\">\n                <span className=\"material-symbols-outlined text-[80px] text-[#191c1e]\">\n                  {service.bgIconName}\n                </span>\n              </div>\n\n              <div>\n                {/* Icon Box */}\n                <div className=\"w-12 h-12 bg-[#ffffff] rounded-lg flex items-center justify-center text-[#191c1e] mb-5 border border-[#c6c6cd] group-hover:border-[#0ea5e9] group-hover:bg-[#0ea5e9]/10 transition-colors shadow-2xs\">\n                  {service.icon}\n                </div>\n\n                <div className=\"flex items-center justify-between mb-2\">\n                  <h3 className=\"font-geist font-bold text-lg text-[#191c1e] group-hover:text-[#006591] transition-colors\">\n                    {service.title}\n                  </h3>\n                  <ArrowUpRight className=\"w-4 h-4 text-[#76777d] group-hover:text-[#0ea5e9] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform\" />\n                </div>\n\n                <p className=\"text-sm text-[#45464d] leading-relaxed mb-6\">\n                  {service.description}\n                </p>\n              </div>\n\n              {/* Footer Tags */}\n              <div className=\"flex gap-1.5 flex-wrap pt-2 border-t border-[#e0e3e5]\">\n                {service.tags.map((tag) => (\n                  <span\n                    key={tag}\n                    className=\"px-2 py-0.5 bg-[#ffffff] text-[#191c1e] text-[10px] font-mono font-semibold rounded border border-[#c6c6cd] group-hover:border-[#0ea5e9]/40\"\n                  >\n                    {tag}\n                  </span>\n                ))}\n              </div>\n            </div>\n          ))}\n        </div>\n\n        {/* Interactive Detail Modal */}\n        {selectedService && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-fadeIn\">\n            <div className=\"bg-white border border-[#c6c6cd] rounded-xl max-w-lg w-full p-6 shadow-2xl relative space-y-5\">\n              \n              <button\n                onClick={() => setSelectedService(null)}\n                className=\"absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-1 rounded-full hover:bg-slate-100 transition-colors\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 bg-sky-50 text-[#006591] rounded-lg flex items-center justify-center border border-sky-200\">\n                  {selectedService.icon}\n                </div>\n                <div>\n                  <span className=\"text-[10px] font-mono uppercase bg-sky-100 text-[#006591] px-2 py-0.5 rounded font-bold\">\n                    {selectedService.badge}\n                  </span>\n                  <h3 className=\"font-geist font-bold text-xl text-slate-900\">{selectedService.title}</h3>\n                </div>\n              </div>\n\n              <p className=\"text-sm text-slate-600 leading-relaxed\">{selectedService.description}</p>\n\n              <div className=\"space-y-2\">\n                <p className=\"text-xs font-bold uppercase text-slate-900 tracking-wider font-mono\">Key Features Included:</p>\n                <ul className=\"space-y-2\">\n                  {selectedService.features.map((feat) => (\n                    <li key={feat} className=\"flex items-start gap-2 text-xs text-slate-700\">\n                      <Check className=\"w-4 h-4 text-emerald-600 shrink-0 mt-0.5\" />\n                      <span>{feat}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n\n              <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-200 text-xs space-y-1\">\n                <p className=\"font-semibold text-slate-900\">Tech Stack &amp; Implementation:</p>\n                <p className=\"text-slate-600 font-mono\">{selectedService.techStack}</p>\n              </div>\n\n              <div className=\"p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-xs text-emerald-900 space-y-1\">\n                <p className=\"font-bold\">Business ROI &amp; Conversion Impact:</p>\n                <p>{selectedService.roiImpact}</p>\n              </div>\n\n              <div className=\"flex gap-2 pt-2\">\n                <button\n                  onClick={() => {\n                    setSelectedService(null);\n                    const form = document.getElementById(\'contact\');\n                    if (form) form.scrollIntoView({ behavior: \'smooth\' });\n                  }}\n                  className=\"w-full bg-[#0ea5e9] hover:bg-[#0284c7] text-white py-2.5 rounded-lg text-xs font-semibold text-center transition-colors\"\n                >\n                  Request This Solution\n                </button>\n              </div>\n\n            </div>\n          </div>\n        )}\n\n      </div>\n    </section>\n  );\n};\n"
    }
