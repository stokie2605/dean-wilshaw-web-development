    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Menu, X, ArrowRight, MessageSquare, Phone } from \'lucide-react\';\n\ninterface HeaderProps {\n  onOpenQuote: () => void;\n  onOpenWhatsApp: () => void;\n}\n\nconst AVATAR_URL = \"https://lh3.googleusercontent.com/aida-public/AB6AXuA8e_CVpDqlJmvVgwq8mfsfv1MN4Xh0R1At79k3YteVYCQD7jQasQqs7QuztqDYFk_FHxuFPxS1tPjfap95ATBzdxT9JWbXfcpAEcK4BEb1jdYnHB-ljlsDzdm7QW0mY6cCAarD6uzfOgFUWCsOvkJmtlFTFj9TickLiAZuczAGbXe4hL1hwoulVe6eJ0D-hqciw0CIPXvZnTTUytNQX2u2nynEleEJWs7d31mlWssjVI7reTt7yOWkMxmw5RDiDea0U9jVUAl0Y9E\";\n\nexport const Header: React.FC<HeaderProps> = ({ onOpenQuote, onOpenWhatsApp }) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  return (\n    <header className=\"fixed top-0 left-0 right-0 z-50 bg-[#f7f9fb]/90 backdrop-blur-md border-b border-[#c6c6cd]/50 transition-all duration-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex justify-between items-center\">\n        {/* Brand Logo & Name */}\n        <a href=\"#\" className=\"flex items-center gap-3 group\">\n          <div className=\"relative flex items-center justify-center\">\n            {/* SVG Logo matching the image: <DW> icon mark */}\n            <div className=\"h-10 px-2 py-1 bg-[#131b2e] text-white rounded font-geist font-extrabold text-sm sm:text-base flex items-center tracking-tighter shadow-sm group-hover:bg-[#0ea5e9] transition-colors\">\n              <span className=\"text-[#0ea5e9] group-hover:text-white mr-0.5\">&lt;</span>\n              <span className=\"font-bold tracking-tight\">DW</span>\n              <span className=\"text-[#0ea5e9] group-hover:text-white ml-0.5\">&gt;</span>\n            </div>\n          </div>\n          \n          <div className=\"flex flex-col\">\n            <div className=\"flex items-center gap-2\">\n              <img\n                src={AVATAR_URL}\n                alt=\"Dean Wilshaw\"\n                className=\"w-7 h-7 rounded-full object-cover border border-[#c6c6cd]\"\n                onError={(e) => {\n                  // Fallback avatar if URL blocked\n                  (e.target as HTMLElement).style.display = \'none\';\n                }}\n              />\n              <span className=\"font-geist font-bold text-lg text-[#191c1e] tracking-tight group-hover:text-[#006591] transition-colors\">\n                Dean Wilshaw\n              </span>\n            </div>\n            <span className=\"text-[10px] tracking-widest uppercase font-semibold text-[#45464d] hidden sm:inline-block\">\n              Web Development\n            </span>\n          </div>\n        </a>\n\n        {/* Desktop Navigation */}\n        <nav className=\"hidden md:flex items-center gap-8 text-sm font-medium text-[#45464d]\">\n          <a href=\"#services\" className=\"hover:text-[#006591] transition-colors\">\n            Services\n          </a>\n          <a href=\"#speed-test\" className=\"hover:text-[#006591] transition-colors flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n            Speed Audit\n          </a>\n          <a href=\"#comparison\" className=\"hover:text-[#006591] transition-colors\">\n            Why Custom\n          </a>\n          <a href=\"#about\" className=\"hover:text-[#006591] transition-colors\">\n            About\n          </a>\n          <a href=\"#process\" className=\"hover:text-[#006591] transition-colors\">\n            Process\n          </a>\n        </nav>\n\n        {/* Desktop CTA Buttons */}\n        <div className=\"hidden md:flex items-center gap-3\">\n          <button\n            onClick={onOpenWhatsApp}\n            className=\"border border-[#191c1e] text-[#191c1e] hover:bg-[#eceef0] px-3.5 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all flex items-center gap-1.5\"\n            title=\"Chat directly on WhatsApp\"\n          >\n            <Phone className=\"w-3.5 h-3.5 text-emerald-600\" />\n            WhatsApp\n          </button>\n          \n          <button\n            onClick={onOpenQuote}\n            className=\"bg-[#0ea5e9] hover:bg-[#0284c7] text-white px-4 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all shadow-sm hover:shadow-md flex items-center gap-1.5\"\n          >\n            Get a Quote\n            <ArrowRight className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        {/* Mobile Menu Button */}\n        <button\n          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n          className=\"md:hidden p-2 text-[#191c1e] hover:bg-[#eceef0] rounded-lg transition-colors\"\n          aria-label=\"Toggle menu\"\n        >\n          {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n      </div>\n\n      {/* Mobile Menu Dropdown */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden bg-[#f7f9fb] border-b border-[#c6c6cd] px-4 pt-2 pb-6 flex flex-col gap-4 shadow-lg animate-fadeIn\">\n          <nav className=\"flex flex-col gap-3 font-medium text-[#191c1e] pt-2\">\n            <a\n              href=\"#services\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-2 border-b border-[#e0e3e5] hover:text-[#006591]\"\n            >\n              Services & Bento\n            </a>\n            <a\n              href=\"#speed-test\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-2 border-b border-[#e0e3e5] hover:text-[#006591] flex items-center justify-between\"\n            >\n              <span>Speed & Web Vitals Audit</span>\n              <span className=\"text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold\">100/100</span>\n            </a>\n            <a\n              href=\"#comparison\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-2 border-b border-[#e0e3e5] hover:text-[#006591]\"\n            >\n              Custom vs WordPress\n            </a>\n            <a\n              href=\"#about\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-2 border-b border-[#e0e3e5] hover:text-[#006591]\"\n            >\n              Operational Discipline (About)\n            </a>\n            <a\n              href=\"#process\"\n              onClick={() => setMobileMenuOpen(false)}\n              className=\"py-2 hover:text-[#006591]\"\n            >\n              4-Step Process\n            </a>\n          </nav>\n\n          <div className=\"flex flex-col gap-2.5 pt-2\">\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenQuote();\n              }}\n              className=\"w-full bg-[#0ea5e9] hover:bg-[#0284c7] text-white py-3 rounded-lg font-semibold text-sm flex justify-center items-center gap-2 shadow-sm\"\n            >\n              Get a Quote\n              <ArrowRight className=\"w-4 h-4\" />\n            </button>\n\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onOpenWhatsApp();\n              }}\n              className=\"w-full border border-[#191c1e] text-[#191c1e] hover:bg-[#eceef0] py-3 rounded-lg font-semibold text-sm flex justify-center items-center gap-2\"\n            >\n              <MessageSquare className=\"w-4 h-4 text-emerald-600\" />\n              Message on WhatsApp\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
