  file_change {
    absolute_path_uri: "file:///src/components/WhatsAppModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Send, MessageSquare, Phone, CheckCircle2 } from \'lucide-react\';\n\ninterface WhatsAppModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const WhatsAppModal: React.FC<WhatsAppModalProps> = ({ isOpen, onClose }) => {\n  const [topic, setTopic] = useState(\'quote\');\n  const [customMsg, setCustomMsg] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const getPresetMessage = () => {\n    if (customMsg.trim()) return customMsg;\n    if (topic === \'quote\') return \"Hi Dean, I saw your web development studio and would like to get a quote for a high-performance website.\";\n    if (topic === \'speed\') return \"Hi Dean, my current website feels slow. I\'d like to talk about upgrading to a custom React build.\";\n    if (topic === \'seo\') return \"Hi Dean, I need better Google search rankings for my local business in Cheshire / Stoke.\";\n    return \"Hi Dean, I\'d like to discuss a new website project.\";\n  };\n\n  const handleOpenWhatsAppLink = () => {\n    const text = encodeURIComponent(getPresetMessage());\n    // UK WhatsApp standard format\n    const whatsappUrl = `https://wa.me/447700900123?text=${text}`;\n    window.open(whatsappUrl, \'_blank\', \'noopener,noreferrer\');\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-fadeIn\">\n      <div className=\"bg-white border border-[#c6c6cd] rounded-xl max-w-md w-full p-6 shadow-2xl relative space-y-5\">\n        \n        <button\n          onClick={onClose}\n          className=\"absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-1 rounded-full hover:bg-slate-100\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-12 h-12 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center shrink-0\">\n            <MessageSquare className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <span className=\"text-[10px] font-mono bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-bold\">\n              DIRECT WHATSAPP CHANNEL\n            </span>\n            <h3 className=\"font-geist font-bold text-xl text-slate-900\">Message Dean Wilshaw</h3>\n          </div>\n        </div>\n\n        <p className=\"text-xs text-slate-600 leading-relaxed\">\n          Need a fast response? Dean responds directly on WhatsApp during business hours (Mon-Sat, 8am-7pm).\n        </p>\n\n        <div className=\"space-y-2\">\n          <label className=\"block text-xs font-semibold text-slate-900 font-mono\">Select Conversation Topic:</label>\n          <div className=\"grid grid-cols-1 gap-2 text-xs\">\n            <button\n              type=\"button\"\n              onClick={() => setTopic(\'quote\')}\n              className={`p-2.5 rounded-lg border text-left transition-colors flex items-center justify-between ${\n                topic === \'quote\' ? \'border-emerald-600 bg-emerald-50 text-emerald-950 font-semibold\' : \'border-slate-200 hover:bg-slate-50\'\n              }`}\n            >\n              <span>\360\237\222\274 Request a Website Quote</span>\n              {topic === \'quote\' && <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setTopic(\'speed\')}\n              className={`p-2.5 rounded-lg border text-left transition-colors flex items-center justify-between ${\n                topic === \'speed\' ? \'border-emerald-600 bg-emerald-50 text-emerald-950 font-semibold\' : \'border-slate-200 hover:bg-slate-50\'\n              }`}\n            >\n              <span>\342\232\241 Replace Slow WordPress Site</span>\n              {topic === \'speed\' && <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />}\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setTopic(\'seo\')}\n              className={`p-2.5 rounded-lg border text-left transition-colors flex items-center justify-between ${\n                topic === \'seo\' ? \'border-emerald-600 bg-emerald-50 text-emerald-950 font-semibold\' : \'border-slate-200 hover:bg-slate-50\'\n              }`}\n            >\n              <span>\360\237\224\215 Local SEO &amp; Google Rankings</span>\n              {topic === \'seo\' && <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />}\n            </button>\n          </div>\n        </div>\n\n        <div>\n          <label className=\"block text-xs font-semibold text-slate-900 font-mono mb-1\">Optional Message Preview:</label>\n          <textarea\n            rows={2}\n            value={customMsg || getPresetMessage()}\n            onChange={(e) => setCustomMsg(e.target.value)}\n            className=\"w-full bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-xs text-slate-800 focus:outline-none\"\n          ></textarea>\n        </div>\n\n        <button\n          onClick={handleOpenWhatsAppLink}\n          className=\"w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-lg font-semibold text-sm flex justify-center items-center gap-2 shadow-sm\"\n        >\n          <Send className=\"w-4 h-4\" />\n          Open WhatsApp &amp; Start Chat\n        </button>\n\n      </div>\n    </div>\n  );\n};\n"
    }
