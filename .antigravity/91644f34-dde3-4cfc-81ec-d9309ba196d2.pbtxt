      replacement_content: "import React from \'react\';\nimport { Zap, Shield, Layout, Wrench, Search, TrendingUp } from \'lucide-react\';\n\ninterface RowData {\n  feature: string;\n  icon: React.ReactNode;\n  customBuild: string;\n  wordpress: string;\n}\n\nconst COMPARISON_ROWS: RowData[] = [\n  {\n    feature: \'Speed & Load Time\',\n    icon: <Zap className=\"w-5 h-5 text-[#006591]\" />,\n    customBuild: \'Instant sub-second load times, zero code bloat\',\n    wordpress: \'Often slow, burdened with 20+ plugins and heavy theme scripts\'\n  },\n  {\n    feature: \'Security & Reliability\',\n    icon: <Shield className=\"w-5 h-5 text-[#006591]\" />,\n    customBuild: \'Stateless architecture, immune to SQL injection & database hacks\',\n    wordpress: \'Vulnerable SQL database, requires weekly patches & security plugins\'\n  },\n  {\n    feature: \'Design & Professionalism\',\n    icon: <Layout className=\"w-5 h-5 text-[#006591]\" />,\n    customBuild: \'100% bespoke React design, engineered specifically for your brand\',\n    wordpress: \'Generic off-the-shelf templates with awkward mobile layouts\'\n  },\n  {\n    feature: \'Ongoing Maintenance\',\n    icon: <Wrench className=\"w-5 h-5 text-[#006591]\" />,\n    customBuild: \'Zero plugin maintenance, zero surprise update site crashes\',\n    wordpress: \'Frequent plugin conflicts, broken updates, and ongoing fixes needed\'\n  },\n  {\n    feature: \'Google SEO & Web Vitals\',\n    icon: <Search className=\"w-5 h-5 text-[#006591]\" />,\n    customBuild: \'100/100 Core Web Vitals, rich Schema markup for local ranking\',\n    wordpress: \'Bloated DOM elements and render-blocking resources that hurt SEO\'\n  },\n  {\n    feature: \'Lead Conversion (CRO)\',\n    icon: <TrendingUp className=\"w-5 h-5 text-[#006591]\" />,\n    customBuild: \'Custom lead flows, interactive quotes, and WhatsApp integration\',\n    wordpress: \'Static contact forms with weak mobile engagement\'\n  }\n];\n\nexport const ComparisonTable: React.FC = () => {\n  return (\n    <section id=\"comparison\" className=\"py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-[#ffffff] border-b border-[#c6c6cd]/50\">\n      <div className=\"max-w-7xl mx-auto\">\n        \n        {/* Header */}\n        <div className=\"text-center mb-12 flex flex-col items-center\">\n          <h2 className=\"font-geist font-bold text-2xl sm:text-4xl text-[#191c1e] mb-3\">\n            Why Custom Beats Templates\n          </h2>\n          <div className=\"w-16 h-1 bg-[#0ea5e9] rounded-full\"></div>\n          <p className=\"mt-4 text-[#45464d] max-w-xl text-sm sm:text-base\">\n            Templates are easy to deploy but costly to run. Here is how bespoke React engineering stacks up against standard WordPress installs.\n          </p>\n        </div>\n\n        {/* Responsive Table Container */}\n        <div className=\"bg-white border border-[#c6c6cd] rounded-xl overflow-hidden shadow-xs\">\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse min-w-[640px]\">\n              <thead>\n                <tr className=\"bg-[#f1f5f9] border-b border-[#c6c6cd]\">\n                  <th className=\"p-4 sm:p-5 font-geist font-semibold text-sm text-[#191c1e] w-1/3\">\n                    Feature / Metric\n                  </th>\n                  <th className=\"p-4 sm:p-5 font-geist font-bold text-sm text-[#006591] bg-sky-50/60 border-x border-[#c6c6cd]/50 w-1/3\">\n                    Custom Build (Dean Wilshaw)\n                  </th>\n                  <th className=\"p-4 sm:p-5 font-geist font-semibold text-sm text-[#45464d] w-1/3\">\n                    Standard WordPress Templates\n                  </th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-[#f1f5f9]\">\n                {COMPARISON_ROWS.map((row) => (\n                  <tr key={row.feature} className=\"hover:bg-slate-50/80 transition-colors\">\n                    \n                    {/* Feature Column */}\n                    <td className=\"p-4 sm:p-5 font-medium text-sm text-[#191c1e] flex items-center gap-2.5\">\n                      <div className=\"p-1.5 bg-slate-100 rounded-md shrink-0\">\n                        {row.icon}\n                      </div>\n                      <span>{row.feature}</span>\n                    </td>\n\n                    {/* Custom Build Column */}\n                    <td className=\"p-4 sm:p-5 text-sm text-[#191c1e] font-medium bg-sky-50/20 border-x border-[#c6c6cd]/40\">\n                      <div className=\"flex items-start gap-2\">\n                        <span className=\"inline-block w-2 h-2 rounded-full bg-emerald-500 shrink-0 mt-1.5\"></span>\n                        <span>{row.customBuild}</span>\n                      </div>\n                    </td>\n\n                    {/* WordPress Column */}\n                    <td className=\"p-4 sm:p-5 text-sm text-[#45464d] opacity-80\">\n                      <div className=\"flex items-start gap-2\">\n                        <span className=\"inline-block w-2 h-2 rounded-full bg-rose-400 shrink-0 mt-1.5\"></span>\n                        <span>{row.wordpress}</span>\n                      </div>\n                    </td>\n\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
