  file_change {
    absolute_path_uri: "file:///src/components/StitchBot.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { Bot, X, Send, Sparkles, MessageSquare, Minimize2, ChevronUp } from \'lucide-react\';\nimport { ChatMessage } from \'../types\';\n\ninterface StitchBotProps {\n  onOpenQuote: () => void;\n  onOpenWhatsApp: () => void;\n}\n\nexport const StitchBot: React.FC<StitchBotProps> = ({ onOpenQuote, onOpenWhatsApp }) => {\n  const [isOpen, setIsOpen] = useState(true);\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: \'1\',\n      sender: \'stitch\',\n      text: \"Hi there! I\'m Stitch, Dean\'s virtual assistant. Looking to grow your business with a website that actually works? I\'m here to help.\",\n      timestamp: new Date(),\n    },\n  ]);\n  const [input, setInput] = useState(\'\');\n  const [loading, setLoading] = useState(false);\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n\n  const scrollToBottom = () => {\n    messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\n  };\n\n  useEffect(() => {\n    if (isOpen) {\n      scrollToBottom();\n    }\n  }, [messages, isOpen]);\n\n  const handleSendMessage = async (textToSend?: string) => {\n    const messageText = textToSend || input;\n    if (!messageText.trim() || loading) return;\n\n    const userMsg: ChatMessage = {\n      id: Date.now().toString(),\n      sender: \'user\',\n      text: messageText,\n      timestamp: new Date(),\n    };\n\n    setMessages((prev) => [...prev, userMsg]);\n    if (!textToSend) setInput(\'\');\n    setLoading(true);\n\n    try {\n      const history = messages.map((m) => ({\n        role: m.sender === \'user\' ? \'user\' : \'assistant\',\n        content: m.text,\n      }));\n\n      const res = await fetch(\'/api/chat\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ message: messageText, history }),\n      });\n\n      if (res.ok) {\n        const data = await res.json();\n        const botMsg: ChatMessage = {\n          id: (Date.now() + 1).toString(),\n          sender: \'stitch\',\n          text: data.response || \"I\'d be glad to help answer any questions or help calculate a quote for your business website!\",\n          timestamp: new Date(),\n        };\n        setMessages((prev) => [...prev, botMsg]);\n      } else {\n        throw new Error(\'API error\');\n      }\n    } catch (err) {\n      console.error(\'Stitch chat error:\', err);\n      // Fallback response\n      const botMsg: ChatMessage = {\n        id: (Date.now() + 1).toString(),\n        sender: \'stitch\',\n        text: \"Dean builds custom React websites for Cheshire & Stoke local businesses. They load in under 0.5s and feature 100/100 Core Web Vitals. Would you like to request a quote or message Dean on WhatsApp?\",\n        timestamp: new Date(),\n      };\n      setMessages((prev) => [...prev, botMsg]);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  if (!isOpen) {\n    return (\n      <button\n        onClick={() => setIsOpen(true)}\n        className=\"fixed bottom-5 right-5 z-50 bg-[#0ea5e9] hover:bg-[#0284c7] text-white p-3.5 sm:p-4 rounded-full shadow-2xl flex items-center gap-2.5 transition-all hover:scale-105 group border-2 border-white\"\n        aria-label=\"Open Stitch Virtual Assistant\"\n      >\n        <div className=\"relative\">\n          <Bot className=\"w-6 h-6\" />\n          <span className=\"absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping\"></span>\n        </div>\n        <span className=\"font-geist font-semibold text-xs sm:text-sm pr-1 hidden sm:inline-block\">\n          Ask Stitch (AI Assistant)\n        </span>\n      </button>\n    );\n  }\n\n  return (\n    <aside\n      id=\"chatbot-container\"\n      className=\"fixed right-3 sm:right-6 bottom-3 sm:bottom-6 z-50 w-[calc(100vw-24px)] sm:w-80 md:w-96 rounded-xl overflow-hidden border border-[#c6c6cd] shadow-2xl bg-white flex flex-col h-[480px] sm:h-[520px] transition-all animate-fadeIn\"\n    >\n      {/* Chat Header */}\n      <div className=\"bg-[#131b2e] p-3.5 sm:p-4 flex items-center justify-between border-b border-[#c6c6cd]/30 shrink-0 text-white\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-9 h-9 bg-white/10 rounded-full flex items-center justify-center border border-white/20 shrink-0\">\n            <Bot className=\"w-5 h-5 text-[#0ea5e9]\" />\n          </div>\n          <div>\n            <h3 className=\"font-geist font-bold text-sm text-white leading-tight flex items-center gap-1.5\">\n              Stitch Support\n              <span className=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n            </h3>\n            <p className=\"text-[11px] text-slate-300 font-mono\">Ask me anything about Dean\'s builds</p>\n          </div>\n        </div>\n\n        <button\n          onClick={() => setIsOpen(false)}\n          className=\"text-slate-300 hover:text-white p-1 rounded-md hover:bg-white/10 transition-colors\"\n          aria-label=\"Close chat\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n      </div>\n\n      {/* Chat Content Messages Area */}\n      <div className=\"flex-grow bg-[#f8fafc] p-4 overflow-y-auto flex flex-col gap-3 text-xs sm:text-sm\">\n        {messages.map((msg) => (\n          <div\n            key={msg.id}\n            className={`flex gap-2 max-w-[90%] ${\n              msg.sender === \'user\' ? \'ml-auto flex-row-reverse\' : \'mr-auto\'\n            }`}\n          >\n            {msg.sender === \'stitch\' && (\n              <div className=\"w-6 h-6 bg-[#eceef0] border border-[#c6c6cd] rounded-full flex items-center justify-center shrink-0 mt-1\">\n                <Bot className=\"w-3.5 h-3.5 text-[#006591]\" />\n              </div>\n            )}\n\n            <div\n              className={`p-3 rounded-2xl ${\n                msg.sender === \'user\'\n                  ? \'bg-[#0ea5e9] text-white rounded-tr-xs shadow-2xs font-medium\'\n                  : \'bg-white border border-[#c6c6cd] text-[#191c1e] rounded-tl-xs shadow-2xs\'\n              }`}\n            >\n              {msg.text}\n            </div>\n          </div>\n        ))}\n\n        {loading && (\n          <div className=\"flex gap-2 max-w-[80%] mr-auto items-center\">\n            <div className=\"w-6 h-6 bg-[#eceef0] rounded-full flex items-center justify-center\">\n              <Bot className=\"w-3.5 h-3.5 text-[#006591]\" />\n            </div>\n            <div className=\"bg-white border border-[#c6c6cd] p-3 rounded-2xl text-xs text-slate-500 font-mono flex items-center gap-1.5\">\n              <span className=\"w-1.5 h-1.5 rounded-full bg-[#0ea5e9] animate-ping\"></span>\n              Stitch is thinking...\n            </div>\n          </div>\n        )}\n\n        <div ref={messagesEndRef} />\n      </div>\n\n      {/* Suggested Fast Prompts */}\n      <div className=\"bg-[#f1f5f9] px-3 py-2 border-t border-[#c6c6cd]/50 flex items-center gap-1.5 overflow-x-auto hide-scrollbar text-[11px]\">\n        <button\n          onClick={() => handleSendMessage(\"How much does a custom website cost?\")}\n          className=\"shrink-0 bg-white hover:bg-sky-50 text-[#006591] border border-[#c6c6cd] px-2.5 py-1 rounded-full font-medium transition-colors\"\n        >\n          \360\237\222\260 Cost &amp; Pricing\n        </button>\n        <button\n          onClick={() => handleSendMessage(\"How fast are Dean\'s React websites?\")}\n          className=\"shrink-0 bg-white hover:bg-sky-50 text-[#006591] border border-[#c6c6cd] px-2.5 py-1 rounded-full font-medium transition-colors\"\n        >\n          \342\232\241 Speed &amp; Vitals\n        </button>\n        <button\n          onClick={() => handleSendMessage(\"Do you cover Cheshire & Stoke-on-Trent?\")}\n          className=\"shrink-0 bg-white hover:bg-sky-50 text-[#006591] border border-[#c6c6cd] px-2.5 py-1 rounded-full font-medium transition-colors\"\n        >\n          \360\237\223\215 Coverage\n        </button>\n      </div>\n\n      {/* Chat Input Area */}\n      <div className=\"p-3 bg-white border-t border-[#c6c6cd] shrink-0\">\n        <form\n          onSubmit={(e) => {\n            e.preventDefault();\n            handleSendMessage();\n          }}\n          className=\"flex items-center gap-2\"\n        >\n          <input\n            type=\"text\"\n            placeholder=\"Type your question...\"\n            value={input}\n            onChange={(e) => setInput(e.target.value)}\n            className=\"flex-grow bg-[#f8fafc] border border-[#c6c6cd] rounded-lg px-3 py-2 text-xs sm:text-sm text-[#191c1e] focus:outline-none focus:border-[#0ea5e9]\"\n          />\n\n          <button\n            type=\"submit\"\n            disabled={!input.trim() || loading}\n            className=\"bg-[#0ea5e9] hover:bg-[#0284c7] disabled:opacity-50 text-white p-2 sm:px-3 sm:py-2 rounded-lg text-xs font-semibold flex items-center justify-center transition-colors\"\n          >\n            <Send className=\"w-4 h-4\" />\n          </button>\n        </form>\n\n        <div className=\"flex items-center justify-between mt-2 pt-1 text-[10px] text-[#76777d]\">\n          <button onClick={onOpenQuote} className=\"hover:underline text-[#006591] font-medium\">\n            Request Quote Directly\n          </button>\n          <button onClick={onOpenWhatsApp} className=\"hover:underline text-emerald-700 font-medium\">\n            WhatsApp Dean\n          </button>\n        </div>\n      </div>\n    </aside>\n  );\n};\n"
    }
